{
  "about": "The container listing face: Source <container> as=text/uri-list. The `kernel` cases are what ikigai-fs answers (ikigai-cli 0.2.8 and 0.2.9) over `tree`, byte for byte; tests/test_resources_interop.py asserts the live kernel still answers each `body` exactly. The `parse` cases pin how a body reads as IRIs (RFC 2483: CRLF or LF, `#` comments, blank lines dropped). Shared with the TypeScript face; copy without reformatting.",
  "tree": [
    "deck/.hidden.md",
    "deck/00-title.md",
    "deck/10-body.md",
    "deck/theme.css",
    "deck/sub/20-nested.md",
    "deck/with space.md",
    "deck/ü.md",
    "empty/"
  ],
  "kernel": [
    {
      "container": "urn:file:deck",
      "media_type": "text/uri-list",
      "body": "urn:file:deck/.hidden.md\nurn:file:deck/00-title.md\nurn:file:deck/10-body.md\nurn:file:deck/sub\nurn:file:deck/theme.css\nurn:file:deck/with%20space.md\nurn:file:deck/%C3%BC.md",
      "children": [
        "urn:file:deck/.hidden.md",
        "urn:file:deck/00-title.md",
        "urn:file:deck/10-body.md",
        "urn:file:deck/sub",
        "urn:file:deck/theme.css",
        "urn:file:deck/with%20space.md",
        "urn:file:deck/%C3%BC.md"
      ]
    },
    {
      "container": "urn:file:deck/sub",
      "media_type": "text/uri-list",
      "body": "urn:file:deck/sub/20-nested.md",
      "children": [
        "urn:file:deck/sub/20-nested.md"
      ]
    },
    {
      "container": "urn:file:empty",
      "media_type": "text/uri-list",
      "body": "",
      "children": []
    }
  ],
  "parse": [
    {
      "name": "crlf",
      "body": "urn:file:a/x.md\r\nurn:file:a/y.md\r\n",
      "children": [
        "urn:file:a/x.md",
        "urn:file:a/y.md"
      ]
    },
    {
      "name": "trailing-lf",
      "body": "urn:file:a/x.md\n",
      "children": [
        "urn:file:a/x.md"
      ]
    },
    {
      "name": "comments-and-blank-lines",
      "body": "# a listing\nurn:file:a/x.md\n\n#urn:file:a/hidden\nurn:file:a/y.md",
      "children": [
        "urn:file:a/x.md",
        "urn:file:a/y.md"
      ]
    },
    {
      "name": "empty",
      "body": "",
      "children": []
    }
  ]
}
