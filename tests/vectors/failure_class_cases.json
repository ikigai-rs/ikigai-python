        "elapsed_us": 120000000,
        "detail": "unavailable: the hub refused the connection"
      }
    },
    {
      "name": "gave-up/a-fraction-of-a-millisecond-rounds-down",
      "error": {
        "kind": "gave-up",
        "attempts": 3,
        "elapsed_us": 1900,
        "detail": "timeout: the origin did not answer in 1 ms"
      }
    },
    {
      "name": "gave-up/one-attempt",
      "error": {
        "kind": "gave-up",
        "attempts": 1,
        "elapsed_us": 250000,
        "detail": "unavailable: connection refused"
      }
    }
  ]
}
