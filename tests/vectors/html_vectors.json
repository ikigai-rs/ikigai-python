  "safe_href": [
    {
      "in": "https://example.org/a?b=1&c=2",
      "out": "https://example.org/a?b=1&c=2",
      "why": "https, query kept as given; escape it with attr"
    },
    {
      "in": "http://example.org/",
      "out": "http://example.org/",
      "why": "http"
    },
    {
      "in": "HTTPS://EXAMPLE.ORG/",
      "out": "HTTPS://EXAMPLE.ORG/",
      "why": "scheme in upper case"
    },
    {
      "in": "HtTp://example.org/",
      "out": "HtTp://example.org/",
      "why": "scheme in mixed case"
    },
    {
      "in": "/r/urn:cms:tags",
      "out": "/r/urn:cms:tags",
      "why": "a same-origin path"
    },
    {
      "in": "/",
      "out": "/",
      "why": "the origin's root"
    },
    {
      "in": "/café/日",
      "out": "/café/日",
      "why": "a path with Unicode"
    },
    {
      "in": "https://éxample.org/",
      "out": "https://éxample.org/",
      "why": "an IDN host"
    },
    {
      "in": "/%2F/evil.example",
      "out": "/%2F/evil.example",
      "why": "an encoded slash is not a slash"
    },
    {
      "in": "/%5Cevil.example",
      "out": "/%5Cevil.example",
      "why": "an encoded backslash is not a backslash"
    },
    {
      "in": " https://example.org/",
      "out": "https://example.org/",
      "why": "leading space trimmed"
    },
    {
      "in": "\t\n https://example.org/ \r\n",
      "out": "https://example.org/",
      "why": "leading and trailing whitespace trimmed"
    },
    {
      "in": "\u0000\u001f/a",
      "out": "/a",
      "why": "leading C0 controls trimmed, as a browser does"
    },
    {
      "in": "//evil.example/",
      "out": null,
      "why": "a protocol-relative URL names another host"
    },
    {
      "in": "/\\evil.example/",
      "out": null,
      "why": "a browser reads /\\ as //"
    },
    {
      "in": " //evil.example/",
      "out": null,
      "why": "another host behind leading whitespace"
    },
    {
      "in": "/\t/evil.example/",
      "out": null,
      "why": "a browser deletes the tab and reads //"
    },
    {
      "in": "/\n/evil.example/",
      "out": null,
      "why": "a browser deletes the newline and reads //"
    },
    {
      "in": "javascript:alert(1)",
      "out": null,
      "why": "javascript:"
    },
    {
      "in": "JaVaScRiPt:alert(1)",
      "out": null,
      "why": "javascript: in mixed case"
    },
    {
      "in": "JAVASCRIPT:alert(1)",
      "out": null,
      "why": "javascript: in upper case"
    },
    {
      "in": " javascript:alert(1)",
      "out": null,
      "why": "javascript: behind a space"
    },
    {
      "in": "\t javascript:alert(1)",
      "out": null,
      "why": "javascript: behind a tab"
    },
    {
      "in": "java\tscript:alert(1)",
      "out": null,
      "why": "a tab inside the scheme, which a browser deletes"
    },
    {
      "in": "java\nscript:alert(1)",
      "out": null,
      "why": "a newline inside the scheme"
    },
    {
      "in": "java\rscript:alert(1)",
      "out": null,
      "why": "a carriage return inside the scheme"
    },
    {
      "in": "ht\ttps://example.org/",
      "out": null,
      "why": "a tab inside an allowed scheme is refused too"
    },
    {
      "in": "https://exa\u0000mple.org/",
      "out": null,
      "why": "a NUL inside the target"
    },
    {
      "in": "https://example.org/\u0000",
      "out": "https://example.org/",
      "why": "a trailing NUL is trimmed, as a browser does"
    },
    {
      "in": "https://example.org/",
      "out": null,
      "why": "a DEL inside the target"
    },
    {
      "in": "data:text/html,<b>x</b>",
      "out": null,
      "why": "data:"
    },
    {
      "in": "DATA:text/html;base64,PGI+",
      "out": null,
      "why": "data: in upper case"
    },
    {
      "in": "vbscript:msgbox(1)",
      "out": null,
      "why": "vbscript:"
    },
    {
      "in": "file:///decks/talk",
      "out": null,
      "why": "file:"
    },
    {
      "in": "mailto:someone@example.org",
      "out": null,
      "why": "mailto: is not on the list"
    },
    {
      "in": "r/urn:cms:tags",
      "out": null,
      "why": "a relative path without a leading slash"
    },
    {
      "in": "./a",
      "out": null,
      "why": "a dot-relative path"
    },
    {
      "in": "?q=1",
      "out": null,
      "why": "a query alone"
    },
    {
      "in": "#top",
      "out": null,
      "why": "a fragment alone"
    },
    {
      "in": "https:/example.org",
      "out": null,
      "why": "one slash after https:"
    },
    {
      "in": "http:example.org",
      "out": null,
      "why": "no slashes after http:"
    },
    {
      "in": "https:\\\\example.org",
      "out": null,
      "why": "backslashes after https:"
    },
    {
      "in": "%6Aavascript:alert(1)",
      "out": null,
      "why": "a percent-encoded scheme is not a scheme, and not a path"
    },
    {
      "in": " https://example.org/",
      "out": null,
      "why": "a no-break space is not trimmed"
    },
    {
      "in": "ｈttps://example.org/",
      "out": null,
      "why": "a fullwidth letter is not ASCII"
    },
    {
      "in": "",
      "out": null,
      "why": "empty"
    },
    {
      "in": "   ",
      "out": null,
      "why": "only whitespace"
    }
  ],
  "json_attr": [
    {
      "in": [],
      "out": "{}"
    },
    {
      "in": [
        [
          "q",
          "a"
        ]
      ],
      "out": "{&quot;q&quot;:&quot;a&quot;}"
    },
    {
      "in": [
        [
          "tag",
          "c++"
        ],
        [
          "page",
          "2"
        ]
      ],
      "out": "{&quot;tag&quot;:&quot;c++&quot;,&quot;page&quot;:&quot;2&quot;}"
    },
    {
      "in": [
        [
          "note",
          "say \"hi\""
        ]
      ],
      "out": "{&quot;note&quot;:&quot;say \\&quot;hi\\&quot;&quot;}"
    },
    {
      "in": [
        [
          "path",
          "C:\\dir"
        ]
      ],
      "out": "{&quot;path&quot;:&quot;C:\\\\dir&quot;}"
    },
    {
      "in": [
        [
          "x",
          "a\nb\rc\td\bf\f"
        ]
      ],
      "out": "{&quot;x&quot;:&quot;a\\nb\\rc\\td\\bf\\f&quot;}"
    },
    {
      "in": [
        [
          "x",
          "\u0000\u001f"
        ]
      ],
      "out": "{&quot;x&quot;:&quot;\\u0000\\u001f&quot;}"
    },
    {
      "in": [
        [
          "x",
          "</script><b>&'"
        ]
      ],
      "out": "{&quot;x&quot;:&quot;&lt;/script&gt;&lt;b&gt;&amp;&#39;&quot;}"
    },
    {
      "in": [
        [
          "café",
          "✓"
        ]
      ],
      "out": "{&quot;café&quot;:&quot;✓&quot;}"
    },
    {
      "in": [
        [
          "k",
          "1"
        ],
        [
          "k",
          "2"
        ]
      ],
      "out": "{&quot;k&quot;:&quot;1&quot;,&quot;k&quot;:&quot;2&quot;}"
    }
  ]
}
