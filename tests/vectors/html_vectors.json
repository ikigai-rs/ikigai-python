{
  "about": "Shared escaping and link-target vectors for HTML built from data (ledger #1813). The canonical copy is ikigai-fn's tests/vectors/html_vectors.json, consumed by tests/html_vectors.rs; a port (Python, Deno, an XSLT template) keeps a VERBATIM copy and runs every case. The expected outputs are written by hand, not computed: they are the contract. html_text and attr give the same output (attr is html_text under the name that says where it goes), so both run the 'escape' cases. A safe_href output of null means: not a link, render the label as text; otherwise the output is the trimmed target, still to be escaped with attr. A json_attr input is a list of [key, value] pairs, in order.",
  "escape": [
    {
      "in": "",
      "out": ""
    },
    {
      "in": "plain text",
      "out": "plain text"
    },
    {
      "in": "&",
      "out": "&amp;"
    },
    {
      "in": "<",
      "out": "&lt;"
    },
    {
      "in": ">",
      "out": "&gt;"
    },
    {
      "in": "\"",
      "out": "&quot;"
    },
    {
      "in": "'",
      "out": "&#39;"
    },
    {
      "in": "<script>alert('x')</script>",
      "out": "&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt;"
    },
    {
      "in": "Tom & Jerry's \"show\"",
      "out": "Tom &amp; Jerry&#39;s &quot;show&quot;"
    },
    {
      "in": "&amp; is already an entity",
      "out": "&amp;amp; is already an entity"
    },
    {
      "in": "&#39;",
      "out": "&amp;#39;"
    },
    {
      "in": "tab\tline\nreturn\r",
      "out": "tab\tline\nreturn\r"
    },
    {
      "in": "nul\u0000soh\u0001esc\u001bus\u001f",
      "out": "nul�soh�esc�us�"
    },
    {
      "in": "del stays",
      "out": "del stays"
    },
    {
      "in": "café ✓ 日本 😀",
      "out": "café ✓ 日本 😀"
    },
    {
      "in": "nbsp and line sep ",
      "out": "nbsp and line sep "
    },
    {
      "in": "$h{urn:example:x}",
      "out": "$h{urn:example:x}"
    },
    {
      "in": "a=b c`d",
      "out": "a=b c`d"
    }
  ],
